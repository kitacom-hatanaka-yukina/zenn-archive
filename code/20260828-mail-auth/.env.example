# 送信先（自分宛のみ）
MAIL_TO=replace-me

# ヘッダ From に詐称する架空ドメイン
MAIL_SPOOF_FROM=スーパーウルトラメガ銀行 <info@super-ultra-mega-bank.example>

# 自分が管理する正規ドメイン
MAIL_MY_DOMAIN=mydomain.example
MAIL_BOUNCE_ADDR=bounce@mydomain.example

# 送信先ドメインの受信サーバ
MAIL_SMTP_HOST=gmail-smtp-in.l.google.com
MAIL_SMTP_PORT=25

# DKIM
MAIL_DKIM_SELECTOR=selector1
MAIL_DKIM_PRIVATE_KEY=private.key
